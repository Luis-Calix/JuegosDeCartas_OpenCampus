<UserControl x:Class="JuegosDeCartas_OpenCampus.Views.GameModeSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JuegosDeCartas_OpenCampus.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Border Width="450"
        Height="420"
        CornerRadius="15"
        BorderBrush="#D4AF37"
        BorderThickness="2"
        Padding="30"
        VerticalAlignment="Center"
        HorizontalAlignment="Center">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2B1B4A"/>
                    <GradientStop Color="#1A0F2E" Offset="1"/>
                </LinearGradientBrush>

            </Border.Background>

            <StackPanel>

                <TextBlock Text="Seleccionar Modo"
           FontSize="28"
           Foreground="#F2D479"
           HorizontalAlignment="Center"
           Margin="0 0 0 40"/>

                <Button Content="🌐 Multijugador Online"
        Style="{DynamicResource GoldButton}"
        Command="{Binding OnlineModeCommand}"/>

                <Button Content="👥 Multijugador Local"
        Style="{DynamicResource GoldButton}"
        Command="{Binding LocalModeCommand}"/>

                <Button Content="🤖 Contra la Máquina"
        Style="{DynamicResource GoldButton}"
        Command="{Binding CpuModeCommand}"/>

                <Button Content="Volver"
        Style="{DynamicResource BackButton}"
        Command="{Binding BackCommand}"/>

            </StackPanel>

        </Border>

    </Grid>
</UserControl>
