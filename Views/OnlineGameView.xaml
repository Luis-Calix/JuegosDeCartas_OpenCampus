<UserControl x:Class="JuegosDeCartas_OpenCampus.Views.OnlineGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JuegosDeCartas_OpenCampus.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid>

        <!-- FONDO MESA DE CASINO -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/poker_texture.jpg"
                        Stretch="Uniform"/>
        </Grid.Background>

        <!-- BORDE DE MESA -->
        <Border Margin="30"
                CornerRadius="25"
                BorderThickness="4"
                BorderBrush="#D4AF37">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ENCABEZADO: TÍTULO + ESTADO DE TURNO -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="{Binding GameTitle}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#F2D479"
                               HorizontalAlignment="Center"
                               Margin="0 10 0 4"/>

                    <!-- INDICADOR DE TURNO -->
                    <Border HorizontalAlignment="Center"
                            CornerRadius="10"
                            Padding="16 4"
                            Margin="0 0 0 6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#CC8B0000"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMyTurn}" Value="True">
                                        <Setter Property="Background" Value="#CC1A6B1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </Border>

                </StackPanel>

                <!-- ÁREA DE JUEGO -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- PANEL IZQUIERDO: TU MARCADOR -->
                    <Border Grid.Column="0"
                            Background="#881A1A2E"
                            CornerRadius="8"
                            BorderBrush="#D4AF37"
                            BorderThickness="1"
                            Margin="10"
                            Padding="10"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Tú"
                                       Foreground="#F2D479"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"/>
                            <Separator Background="#D4AF37" Margin="0 4"/>
                            <TextBlock Foreground="White" FontSize="12" Margin="0 2">
                                <Run Text="Puntos: "/>
                                <Run Text="{Binding PlayerScore}"
                                     FontWeight="Bold"
                                     Foreground="#7EC8E3"/>
                            </TextBlock>
                            <TextBlock Foreground="White" FontSize="12" Margin="0 2">
                                <Run Text="Victorias: "/>
                                <Run Text="{Binding MyWins}"
                                     FontWeight="Bold"
                                     Foreground="#A8D8A8"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- CENTRO: CARTAS -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- CARTAS DEALER -->
                        <StackPanel Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    Margin="0 10">
                            <TextBlock Text="Dealer"
                                       FontSize="16"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0 0 0 4"/>
                            <TextBlock Foreground="#B0B0B0"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0 0 0 6">
                                <Run Text="Puntos: "/>
                                <Run Text="{Binding DealerScore}" Foreground="White"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding DealerCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding ImagePath}"
                                               Width="70"
                                               Margin="4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- SEPARADOR -->
                        <Border Grid.Row="1"
                                Height="2"
                                Background="#D4AF37"
                                Margin="40 0"/>

                        <!-- CARTAS JUGADOR -->
                        <StackPanel Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Margin="0 10">
                            <TextBlock Text="Tu mano"
                                       FontSize="16"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0 0 0 4"/>
                            <TextBlock Foreground="#B0B0B0"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0 0 0 6">
                                <Run Text="Puntos: "/>
                                <Run Text="{Binding PlayerScore}" Foreground="White"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PlayerCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding ImagePath}"
                                               Width="80"
                                               Margin="4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </Grid>

                    <!-- PANEL DERECHO: OPONENTE -->
                    <Border Grid.Column="2"
                            Background="#881A1A2E"
                            CornerRadius="8"
                            BorderBrush="#D4AF37"
                            BorderThickness="1"
                            Margin="10"
                            Padding="10"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding OpponentName}"
                                       Foreground="#F2D479"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Separator Background="#D4AF37" Margin="0 4"/>

                            <!-- Cartas del oponente boca abajo -->
                            <ItemsControl ItemsSource="{Binding OpponentCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="/Assets/Cards/back.png"
                                               Width="30"
                                               Margin="2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Foreground="White" FontSize="12" Margin="0 6 0 2"
                                       HorizontalAlignment="Center">
                                <Run Text="Victorias: "/>
                                <Run Text="{Binding OpponentWins}"
                                     FontWeight="Bold"
                                     Foreground="#F2D479"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- CONTROLES -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0 16">

                    <Button Content="Pedir Carta"
                            Style="{StaticResource GoldButton}"
                            Command="{Binding HitCommand}"
                            Width="140"/>

                    <Button Content="Plantarse"
                            Style="{StaticResource GoldButton}"
                            Command="{Binding StandCommand}"
                            Width="140"/>

                    <Button Content="Nueva Ronda"
                            Style="{StaticResource GoldButton}"
                            Command="{Binding NewRoundCommand}"
                            Width="140"/>

                    <Button Content="Salir"
                            Style="{StaticResource BackButton}"
                            Command="{Binding ExitCommand}"
                            Width="120"/>

                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>