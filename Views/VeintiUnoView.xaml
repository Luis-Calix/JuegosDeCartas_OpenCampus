<UserControl x:Class="JuegosDeCartas_OpenCampus.Views.VeintiUnoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/poker_texture.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Margin="30" CornerRadius="25" BorderThickness="4" BorderBrush="#C0392B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0" Text="{Binding GameTitle}"
                           FontSize="32" FontWeight="Bold" Foreground="#E74C3C"
                           HorizontalAlignment="Center" Margin="0,15,0,5"/>

                <!-- Marcador -->
                <Grid Grid.Row="1" Margin="60,5,60,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="TÚ" FontSize="14" Foreground="#AAA" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PlayerWins}" FontSize="42" FontWeight="Bold"
                                   Foreground="#E74C3C" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="VS" FontSize="22" Foreground="White"
                               VerticalAlignment="Center" Margin="20,0"/>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="DEALER" FontSize="14" Foreground="#AAA" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DealerWins}" FontSize="42" FontWeight="Bold"
                                   Foreground="#AAA" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Área de cartas -->
                <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <!-- Carta Jugador -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Tu carta" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Border Width="160" Height="220" CornerRadius="16"
                                Background="White" BorderBrush="#C0392B" BorderThickness="4">
                            <Grid>
                                <TextBlock Text="{Binding PlayerCardSuit}" FontSize="80"
                                           Foreground="{Binding PlayerCardColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.15" Margin="0,30,0,0"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlayerCardDisplay}" FontSize="52" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{Binding PlayerCardColor}"/>
                                    <TextBlock Text="{Binding PlayerCardSuit}" FontSize="28"
                                               HorizontalAlignment="Center"
                                               Foreground="{Binding PlayerCardColor}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- VS central -->
                    <TextBlock Grid.Column="1" Text="⚔" FontSize="52" Foreground="#E74C3C"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Carta Dealer -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Carta del Dealer" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <!-- Boca abajo (antes de revelar) -->
                        <Border Width="160" Height="220" CornerRadius="16"
                                BorderBrush="#C0392B" BorderThickness="4"
                                Visibility="{Binding IsDealerHidden, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2B1B4A" Offset="0"/>
                                    <GradientStop Color="#1A0F2E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🂠" FontSize="80" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#D4AF37"/>
                        </Border>
                        <!-- Revelada -->
                        <Border Width="160" Height="220" CornerRadius="16"
                                Background="White" BorderBrush="#C0392B" BorderThickness="4"
                                Visibility="{Binding IsDealerHidden, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Grid>
                                <TextBlock Text="{Binding DealerCardSuit}" FontSize="80"
                                           Foreground="{Binding DealerCardColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.15" Margin="0,30,0,0"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DealerCardDisplay}" FontSize="52" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{Binding DealerCardColor}"/>
                                    <TextBlock Text="{Binding DealerCardSuit}" FontSize="28"
                                               HorizontalAlignment="Center"
                                               Foreground="{Binding DealerCardColor}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Mensaje -->
                <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="40,10"/>

                <!-- Botones -->
                <StackPanel Grid.Row="4" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button Content="⚔ Robar carta"   Style="{DynamicResource GoldButton}" Command="{Binding DrawCommand}"      Width="160" Margin="8,0"/>
                    <Button Content="▶ Siguiente"      Style="{DynamicResource GoldButton}" Command="{Binding NextRoundCommand}" Width="160" Margin="8,0"/>
                    <Button Content="🔄 Nueva partida" Style="{DynamicResource GoldButton}" Command="{Binding NewGameCommand}"   Width="160" Margin="8,0"/>
                    <Button Content="← Salir"          Style="{DynamicResource BackButton}" Command="{Binding ExitCommand}"     Width="120" Margin="8,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
