<UserControl x:Class="JuegosDeCartas_OpenCampus.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JuegosDeCartas_OpenCampus.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>


        <!-- PANEL IZQUIERDO -->
        <StackPanel Grid.Column="0"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Width="260">

            <TextBlock Text="CARD GAMES"
           FontSize="34"
           FontWeight="Bold"
           Foreground="#F2D479"
           TextAlignment="Center"
           Margin="0 0 0 40"/>

            <Button Content="♠ Blackjack"
        Style="{DynamicResource GoldButton}"
        Command="{Binding OpenBlackjackCommand}"/>

            <Button Content="⚔ Guerra"
        Style="{DynamicResource GoldButton}"
        Command="{Binding OpenTwentyOneCommand}"/>

            <Button Content="♦ Pitipar"
        Style="{DynamicResource GoldButton}"
        Command="{Binding OpenPitiparCommand}"/>

        </StackPanel>

        <!-- SCOREBOARD -->
        <Border Grid.Column="1"
        Margin="40"
        CornerRadius="12"
        BorderBrush="#D4AF37"
        BorderThickness="2"
        Padding="20">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2B1B4A" Offset="0"/>
                    <GradientStop Color="#1A0F2E" Offset="1"/>
                </LinearGradientBrush>

            </Border.Background>

            <StackPanel>

                <TextBlock Text="MEJORES JUGADORES"
           FontSize="26"
           FontWeight="Bold"
           Foreground="#F2D479"
           Margin="0 0 0 20"/>

                <DataGrid ItemsSource="{Binding TopPlayers}"
          AutoGenerateColumns="False"
          Background="Transparent"
          Foreground="White"
          BorderThickness="0"
          GridLinesVisibility="None">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Jugador"
Binding="{Binding PlayerName}"
Width="*"/>

                        <DataGridTextColumn Header="Juego"
Binding="{Binding Game}"
Width="*"/>

                        <DataGridTextColumn Header="Puntos"
Binding="{Binding Points}"
Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Border>

    </Grid>
</UserControl>
