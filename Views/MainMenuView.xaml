<UserControl x:Class="JuegosDeCartas_OpenCampus.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>

        <!-- FONDO -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A0F2E" Offset="0"/>
                <GradientStop Color="#2B1B4A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- CONTENIDO CENTRADO -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="320">

            <!-- TÍTULO -->
            <TextBlock Text="CARD GAMES"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#F2D479"
                       TextAlignment="Center"
                       Margin="0 0 0 10"/>

            <Border Height="2"
                    Background="#D4AF37"
                    Margin="40 0 40 40"/>

            <!-- JUEGOS -->
            <TextBlock Text="Selecciona un juego"
                       FontSize="14"
                       Foreground="#B0B0B0"
                       TextAlignment="Center"
                       Margin="0 0 0 20"/>

            <Button Content="♠  Blackjack"
                    Style="{DynamicResource GoldButton}"
                    Command="{Binding OpenBlackjackCommand}"
                    Width="280" Height="52" FontSize="17"/>

            <Button Content="⚔  Guerra"
                    Style="{DynamicResource GoldButton}"
                    Command="{Binding OpenTwentyOneCommand}"
                    Width="280" Height="52" FontSize="17"/>

            <Button Content="♦  Pitipar"
                    Style="{DynamicResource GoldButton}"
                    Command="{Binding OpenPitiparCommand}"
                    Width="280" Height="52" FontSize="17"/>

            <!-- SEPARADOR -->
            <Border Height="1"
                    Background="#555"
                    Margin="40 24"/>

            <!-- MULTIJUGADOR ONLINE -->
            <Button Content="🌐  Multijugador Online"
                    Style="{DynamicResource GoldButton}"
                    Command="{Binding OpenOnlineCommand}"
                    Width="280" Height="52" FontSize="17"/>

            <!-- INSTRUCCIONES -->
            <Button Content="📖  Instrucciones"
                    Style="{DynamicResource BackButton}"
                    Command="{Binding OpenInstructionsCommand}"
                    Width="280" Height="44" FontSize="15"
                    Margin="0 8 0 0"/>

        </StackPanel>

    </Grid>
</UserControl>