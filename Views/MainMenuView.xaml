<UserControl x:Class="JuegosDeCartas_OpenCampus.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JuegosDeCartas_OpenCampus.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>


        <!-- PANEL IZQUIERDO -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Width="260">

            <TextBlock Text="CARD GAMES"
           FontSize="34"
           FontWeight="Bold"
           Foreground="#F2D479"
           TextAlignment="Center"
           Margin="0 0 0 40"/>

            <Button Content="♠ Blackjack"
        Style="{DynamicResource GoldButton}"
        Command="{Binding OpenBlackjackCommand}"/>

            <Button Content="⚔ Guerra"
        Style="{DynamicResource GoldButton}"
        Command="{Binding OpenTwentyOneCommand}"/>

            <Button Content="♦ Pitipar"
        Style="{DynamicResource GoldButton}"
        Command="{Binding OpenPitiparCommand}"/>

        </StackPanel>
    </Grid>
</UserControl>
