<UserControl x:Class="JuegosDeCartas_OpenCampus.Views.OnlineLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <!-- FONDO -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/poker_texture.jpg"
                        Stretch="Uniform"/>
        </Grid.Background>

        <!-- OVERLAY OSCURO -->
        <Rectangle Fill="#AA000000"/>

        <!-- PANEL CENTRAL -->
        <Border Width="520"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="#CC1A1A2E"
                CornerRadius="16"
                BorderBrush="#D4AF37"
                BorderThickness="2"
                Padding="40 36">

            <StackPanel>

                <!-- TÍTULO -->
                <TextBlock Text="🌐  MULTIJUGADOR ONLINE"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#F2D479"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 28"/>

                <!-- NOMBRE DEL JUGADOR -->
                <TextBlock Text="Tu nombre:" Foreground="White" Margin="0 0 0 4"/>
                <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource LobbyInput}"
                         Margin="0 0 0 12"/>

                <!-- SELECCIONAR JUEGO -->
                <TextBlock Text="Juego:" Foreground="White" Margin="0 0 0 4"/>
                <ComboBox SelectedItem="{Binding SelectedGame}"
                          Style="{StaticResource LobbyCombo}"
                          Margin="0 0 0 24">
                    <ComboBoxItem>BlackJack</ComboBoxItem>
                    <ComboBoxItem>VeintiUno</ComboBoxItem>
                    <ComboBoxItem>Pitipar</ComboBoxItem>
                </ComboBox>

                <!-- SEPARADOR -->
                <Separator Background="#D4AF37" Margin="0 0 0 20"/>

                <!-- CREAR SALA -->
                <TextBlock Text="─── Crear sala ───"
                           Foreground="#B0B0B0"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 10"/>

                <Button Content="Crear Sala Nueva"
                        Command="{Binding CreateRoomCommand}"
                        Style="{StaticResource GoldButton}"
                        Margin="0 0 0 10"/>

                <!-- CÓDIGO GENERADO — visible solo cuando RoomCode no está vacío -->
                <StackPanel Margin="0 0 0 20">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RoomCode}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasRoomCode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#1E3A5F" CornerRadius="8" Padding="10 8">
                            <StackPanel>
                                <TextBlock Text="Código de sala:" Foreground="#B0B0B0" FontSize="11"/>
                                <TextBlock Text="{Binding RoomCode}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="#F2D479"
                                           HorizontalAlignment="Center"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="1"
                                Content="📋"
                                Command="{Binding CopyCodeCommand}"
                                ToolTip="Copiar código"
                                Style="{StaticResource GoldButton}"
                                Width="40" Margin="8 0 0 0"/>
                    </Grid>
                </StackPanel>

                <!-- INICIAR — visible solo cuando GuestJoined=true -->
                <Button Content="▶  Iniciar Partida"
                        Command="{Binding StartGameCommand}"
                        Style="{StaticResource GoldButton}"
                        FontSize="16"
                        Margin="0 0 0 20"
                        Visibility="{Binding GuestJoined,
                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- SEPARADOR -->
                <Separator Background="#D4AF37" Margin="0 0 0 20"/>

                <!-- UNIRSE A SALA -->
                <TextBlock Text="─── Unirse a una sala ───"
                           Foreground="#B0B0B0"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 10"/>

                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding JoinCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource LobbyInput}"
                             FontFamily="Consolas"
                             FontSize="18"
                             MaxLength="6"
                             CharacterCasing="Upper"
                             Margin="0 0 8 0"/>

                    <Button Grid.Column="1"
                            Content="Unirse"
                            Command="{Binding JoinRoomCommand}"
                            Style="{StaticResource GoldButton}"
                            Width="100"/>
                </Grid>

                <!-- SEPARADOR -->
                <Separator Background="#555" Margin="0 20"/>

                <!-- ESTADO -->
                <Border Background="#0D0D1A" CornerRadius="6" Padding="12 8" Margin="0 0 0 16">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#A8D8A8"
                               FontSize="13"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- VOLVER -->
                <Button Content="← Volver"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource BackButton}"
                        HorizontalAlignment="Left"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>