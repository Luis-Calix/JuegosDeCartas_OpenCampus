<UserControl x:Class="JuegosDeCartas_OpenCampus.Views.CasinoGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JuegosDeCartas_OpenCampus.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <!-- FONDO MESA DE CASINO -->

        <Grid.Background>

            
            <ImageBrush ImageSource="pack://application:,,,/Assets/poker_texture.jpg"
                        Stretch="Uniform"/>

        </Grid.Background>

        <!-- BORDE DE MESA -->

        <Border Margin="30"
            CornerRadius="25"
            BorderThickness="4"
            BorderBrush="#D4AF37">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITULO DEL JUEGO -->

                <TextBlock Text="{Binding GameTitle}"
FontSize="32"
FontWeight="Bold"
Foreground="#F2D479"
HorizontalAlignment="Center"
Margin="0 10"/>

                <!-- AREA DE JUEGO -->

                <Grid Grid.Row="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CARTAS DEALER -->

                    <StackPanel Grid.Row="0"
HorizontalAlignment="Center"
Margin="0 20">

                        <TextBlock Text="Dealer"
FontSize="18"
Foreground="White"
HorizontalAlignment="Center"/>

                        <ItemsControl ItemsSource="{Binding DealerCards}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Image Source="{Binding ImagePath}"
Width="80"
Margin="5"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                    <!-- SEPARADOR -->

                    <Border Grid.Row="1"
Height="2"
Background="#D4AF37"
Margin="100 0"/>

                    <!-- CARTAS JUGADOR -->

                    <StackPanel Grid.Row="2"
HorizontalAlignment="Center"
Margin="0 20">

                        <TextBlock Text="Jugador"
FontSize="18"
Foreground="White"
HorizontalAlignment="Center"/>

                        <ItemsControl ItemsSource="{Binding PlayerCards}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Image Source="{Binding ImagePath}"
Width="90"
Margin="5"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Grid>

                <!-- CONTROLES -->

                <StackPanel Grid.Row="2"
Orientation="Horizontal"
HorizontalAlignment="Center"
Margin="0 20">

                    <Button Content="Pedir Carta"
Style="{StaticResource GoldButton}"
Command="{Binding HitCommand}"
Width="140"/>

                    <Button Content="Plantarse"
Style="{StaticResource GoldButton}"
Command="{Binding StandCommand}"
Width="140"/>

                    <Button Content="Nueva Ronda"
Style="{StaticResource GoldButton}"
Command="{Binding NewRoundCommand}"
Width="140"/>

                    <Button Content="Salir"
Style="{StaticResource BackButton}"
Command="{Binding ExitCommand}"
Width="140"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</UserControl>
