<UserControl x:Class="JuegosDeCartas_OpenCampus.Views.InstructionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JuegosDeCartas_OpenCampus.Views"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid>

        <Border Width="750"
        Height="500"
        CornerRadius="15"
        BorderBrush="#D4AF37"
        BorderThickness="2"
        Padding="30"
        VerticalAlignment="Center"
        HorizontalAlignment="Center">

            <Border.Background>

                <LinearGradientBrush>
                    <GradientStop Color="#2B1B4A"/>
                    <GradientStop Color="#1A0F2E" Offset="1"/>
                </LinearGradientBrush>

            </Border.Background>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="INSTRUCCIONES"
FontSize="30"
FontWeight="Bold"
Foreground="#F2D479"
Margin="0 0 0 20"/>

                <ScrollViewer Grid.Row="1">

                    <TextBlock Text="{Binding InstructionsText}"
Foreground="White"
FontSize="16"
TextWrapping="Wrap"/>

                </ScrollViewer>

                <StackPanel Grid.Row="2"
Orientation="Horizontal"
HorizontalAlignment="Right"
Margin="0 20 0 0">

                    <Button Content="Comenzar"
Style="{DynamicResource GoldButton}"
Command="{Binding StartGameCommand}" Height="42"/>

                    <Button Content="Volver"
Style="{DynamicResource BackButton}"
Command="{Binding BackCommand}" Width="74" Height="42"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>
